# 运行 python -m app.cli setup 自动生成 .env 和随机主密钥。
# 主密钥不得提交到仓库，必须与数据库独立备份。
GATEWAY_MASTER_KEY=
GATEWAY_MASTER_KEY_ID=key-1
DATABASE_PATH=data/gateway.db
PUBLIC_BASE_URL=http://localhost:8303
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8303
# 出站登记：null（默认）表示不启用登记校验；填写 JSON 数组即启用强制登记，例如：
# [{"host":"db.internal","port":3306}]
# 明文 MCP 目标还需显式设置 allow_http:true；回环和元数据地址始终禁止。
OUTBOUND_ALLOWLIST=null
LEGACY_COMPAT=false
# SSH/SFTP 主机指纹开关：false（默认）时创建/编辑资产不展示指纹字段且连接不再校验
# （接受任意主机密钥，有中间人风险，仅限可信网络）
SSH_HOST_KEY_ENFORCE=false
# ---- 插件中心 ----
# 插件安装根目录；容器内在 docker-compose 里固定为 /app/plugins（独立可写卷）。
# PLUGINS_DIR=/app/plugins
# 可信插件市场：签名静态索引的来源（http(s):// 或内网 file://）与 ed25519 公钥（base64）。
# 两者都配置后市场可用；不配置不影响网关启动与已启用插件。
PLUGIN_MARKET_URL=
PLUGIN_MARKET_PUBLIC_KEY=
# 部署使用的镜像；默认官方多架构镜像（ghcr.io），自建镜像时改回本地名或自己的 registry 地址
IMAGE_NAME=ghcr.io/sowhati/mcp-asset-gateway
IMAGE_TAG=0.1.0
BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8303
