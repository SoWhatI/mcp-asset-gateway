{
  "id": "acme.postgresql",
  "version": "1.0.1",
  "publisher": "acme",
  "name": "PostgreSQL",
  "description": "PostgreSQL 数据库资产：只读查询、表结构浏览与受控写入。工具语义对齐内置 MySQL 适配器。",
  "sdk_protocol": 1,
  "gateway_compat": ">=0.1",
  "python_compat": ">=3.11",
  "entry": "acme_postgresql:PostgreSQLPlugin",
  "workers": 2,
  "capabilities": {
    "network": true,
    "credential": true,
    "write": true
  },
  "types": [
    {
      "type_id": "acme.postgresql",
      "display_name": "PostgreSQL 数据库",
      "icon": "Coin",
      "default_port": 5432,
      "connection_mode": "host_port",
      "dynamic_tools": false,
      "schema_files": {
        "connection": "schemas/connection.json",
        "account": "schemas/account.json",
        "credential": "schemas/credential.json",
        "policy": "schemas/policy.json"
      },
      "tools": [
        {
          "name": "list_tables",
          "description": "列出当前数据库（或 schema 参数指定库）中的表、属主与注释。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "string",
                "title": "schema 名",
                "maxLength": 128,
                "default": "public"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false
          }
        },
        {
          "name": "describe_table",
          "description": "查看表字段、类型、可空性与注释。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "title": "表名",
                "minLength": 1,
                "maxLength": 256
              },
              "schema": {
                "type": "string",
                "title": "schema 名",
                "maxLength": 128,
                "default": "public"
              }
            },
            "required": [
              "table"
            ],
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false
          }
        },
        {
          "name": "sql_query",
          "description": "执行只读 SQL（SELECT/WITH/SHOW/EXPLAIN）；结果行数与输出字节受账号策略限制。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "sql": {
                "type": "string",
                "title": "SQL 语句",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "sql"
            ],
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false
          }
        },
        {
          "name": "sql_execute",
          "description": "执行 INSERT/UPDATE/DELETE（需账号策略开启 allow_write；UPDATE/DELETE 必须带 WHERE）。返回影响行数，不返回数据。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "sql": {
                "type": "string",
                "title": "SQL 语句",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "sql"
            ],
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": false,
            "destructiveHint": true
          }
        }
      ]
    }
  ]
}
